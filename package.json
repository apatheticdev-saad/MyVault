{
  "name": "myvault",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "vite build",
    "dev": "concurrently -k \"npm:dev:frontend\" \"npm:dev:worker\"",
    "dev:frontend": "vite --host 0.0.0.0",
    "dev:worker": "wrangler dev --port 8787",
    "build": "tsc -b && vite build",
    "preview": "wrangler dev --local",
    "deploy": "npm run build && wrangler deploy --env production",
    "typecheck": "tsc -b --pretty",
    "db:local": "wrangler d1 migrations apply myvault-db --local",
    "db:remote": "wrangler d1 migrations apply myvault-db --remote",
    "db:create": "wrangler d1 create myvault-db",
    "owner:init": "node scripts/initialize-owner.mjs",
    "test": "vitest run tests"
  },
  "dependencies": {
    "hono": "^4.10.4",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261101.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vitest": "4.1.12",
    "wrangler": "4.156.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
